{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.luna.sheets-text",
  "Name": "Google Sheets Text",
  "Description": "Copie des textes partagés depuis Google Sheets",
  "Author": "Luna",
  "Version": "1.0.0.0",
  "SDKVersion": 2,
  "Software": { "MinimumVersion": "6.9" },
  "OS": [
    { "Platform": "windows", "MinimumVersion": "10" },
    { "Platform": "mac", "MinimumVersion": "13" }
  ],
  "Nodejs": { "Version": "20", "Debug": "enabled" },
  "CodePath": "bin/plugin.js",
  "Icon": "images/plugin",
  "Category": "Google Sheets Text",
  "CategoryIcon": "images/plugin",
  "Actions": [
    {
      "UUID": "com.luna.sheets-text.copy",
      "Name": "Google Sheets Text",
      "Tooltip": "Copie un texte depuis Google Sheets",
      "Icon": "images/action",
      "Controllers": ["Keypad"],
      "PropertyInspectorPath": "ui/index.html",
      "States": [{ "Image": "images/state", "TitleAlignment": "middle" }]
    }
  ]
}
